<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_outer_bg"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Column 1: Left Section (Icons & Battery) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <!-- Row 1: Wi-Fi & Mobile Data -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_card_white">

                <ImageView
                    android:id="@+id/widget_wifi_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="Wi-Fi"
                    android:src="@drawable/ic_widget_wifi" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_card_white">

                <ImageView
                    android:id="@+id/widget_data_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="Mobile Data"
                    android:src="@drawable/ic_widget_mobile_data" />
            </FrameLayout>
        </LinearLayout>

        <!-- Row 2: Bluetooth & Location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_card_white">

                <ImageView
                    android:id="@+id/widget_bluetooth_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="Bluetooth"
                    android:src="@drawable/ic_widget_bluetooth" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_card_white">

                <ImageView
                    android:id="@+id/widget_location_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="Location"
                    android:src="@drawable/ic_widget_location" />
            </FrameLayout>
        </LinearLayout>

        <!-- Row 3: Battery Tile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/widget_battery_ring_img"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Battery Gauge" />

            <TextView
                android:id="@+id/widget_battery_pct_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="100%"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Column 2: Middle Section (Date, Processor, Android OS) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <!-- Date Tile -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_card_white"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Thursday, October 15"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp" />
        </FrameLayout>

        <!-- Processor SoC Tile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_card_mint"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="6dp">

            <ImageView
                android:id="@+id/widget_soc_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="SoC Icon"
                android:src="@drawable/ic_proc_snapdragon" />

            <TextView
                android:id="@+id/widget_soc_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Snapdragon 8 Gen 3"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Android OS Version Tile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_white"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">

            <ImageView
                android:id="@+id/widget_android_logo"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Android Logo"
                android:src="@drawable/android_16" />

            <TextView
                android:id="@+id/widget_android_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Android 16"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Column 3: Right Section (Storage Free & Device Model) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Storage Free Tile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.4"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_card_white"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Storage Free"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_storage_free_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="78.38G"
                android:textColor="@color/widget_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_storage_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:progress="60"
                android:progressDrawable="@drawable/widget_progress_bar" />
        </LinearLayout>

        <!-- Device Model Tile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.1"
            android:background="@drawable/widget_card_white"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/widget_brand_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Brand Logo"
                android:src="@drawable/ic_brand_oneplus" />

            <TextView
                android:id="@+id/widget_device_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Nord 4"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
