<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer"
    android:theme="@style/Theme.Material3.DynamicColors.DayNight"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_title_devpulse_status"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_lbl_storage_used"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_medium_storage_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="33.56GB Used"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_lbl_ram_used"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_medium_ram_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5.43GB Used"
            android:textColor="?attr/colorSecondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
